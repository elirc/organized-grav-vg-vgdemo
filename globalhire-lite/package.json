{
  "name": "globalhire-lite",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @globalhire/api run dev",
    "dev:web": "npm --workspace @globalhire/web run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "db:generate": "npm --workspace @globalhire/api run db:generate",
    "db:migrate": "npm --workspace @globalhire/api run db:migrate",
    "db:seed": "npm --workspace @globalhire/api run db:seed"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@prisma/fetch-engine": "^5.22.0",
    "@remix-run/router": "^1.23.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "caniuse-lite": "^1.0.30001791",
    "chai": "^6.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.1.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.74.0",
    "rollup": "^4.60.2",
    "semver": "^7.7.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
